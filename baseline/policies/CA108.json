{
  "id": "CA108",
  "displayName": "CA108 — Block Cross-Device Auth Flows",
  "description": "Blocks high-abuse OAuth flows tied to phishing: denies device-code authentication and OAuth authentication transfer where supported. Exempts freshly approved enterprise device registrations that still need onboarding.",
  "metadata": {
    "criticality": "Critical",
    "v2Status": "NEW",
    "persona": "All users",
    "j0eyvEquivalent": "CA004"
  },
  "include": {
    "users": "all"
  },
  "exclude": {
    "groups": [
      "CA_ExcludedFromCA",
      "BG_BreakGlass",
      "CA_ServiceAccount",
      "CA_DeviceCodeApproved"
    ],
    "guestsAndExternals": true
  },
  "applications": {
    "include": "all"
  },
  "conditions": {
    "authenticationFlows": [
      "deviceCodeFlow",
      "authenticationTransfer"
    ],
    "clientAppTypes": [
      "all"
    ]
  },
  "grant": {
    "operator": "OR",
    "builtInControls": [
      "block"
    ]
  }
}
