{
  "id": "CA902",
  "displayName": "CA902 — Guest - Block High Sign-In Risk",
  "description": "Guest risk remediation: denies high sign-in-risk events even when the guest’s home tenant is lenient (defense against cross-tenant token theft).",
  "metadata": {
    "criticality": "Recommended",
    "v2Status": "Updated",
    "persona": "Guest"
  },
  "include": {
    "users": "guestsAndExternals"
  },
  "exclude": {
    "groups": [
      "AC_ExcludedFromCA",
      "BG_BreakGlass"
    ]
  },
  "applications": {
    "include": "all"
  },
  "conditions": {
    "signInRiskLevels": [
      "high"
    ],
    "clientAppTypes": [
      "all"
    ]
  },
  "grant": {
    "operator": "OR",
    "builtInControls": [
      "block"
    ]
  }
}
