{
  "id": "CA202",
  "displayName": "CA202 - Require App Protection (Mobile)",
  "description": "Mobile application protection posture: requires Intune App Protection Policies on iOS and Android for all cloud apps (not Office 365 only). Matches Microsoft's app protection grant (replaces the retired approved-client-app grant). Phone apps that cannot satisfy app protection fail.",
  "metadata": {
    "criticality": "Critical",
    "v2Status": "Updated",
    "persona": "All users",
    "j0eyvEquivalent": "CA005 / CA006"
  },
  "include": {
    "users": "all"
  },
  "exclude": {
    "groups": [
      "CA_ExcludedFromCA",
      "BG_BreakGlass",
      "CA_ServiceAccount"
    ],
    "guestsAndExternals": true
  },
  "applications": {
    "include": "all"
  },
  "conditions": {
    "platforms": {
      "include": [
        "iOS",
        "android"
      ]
    },
    "clientAppTypes": [
      "all"
    ]
  },
  "grant": {
    "operator": "OR",
    "builtInControls": [
      "compliantApplication"
    ]
  }
}
