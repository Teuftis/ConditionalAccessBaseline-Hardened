      "AC_ServiceAccount_Interactive"
    ]
  },
  "exclude": {
    "groups": [
      "AC_ExcludedFromCA",
      "BG_BreakGlass",
      "AC_ServiceAccount_NonInteractive"
    ]
  },
  "applications": {
    "include": "all"
  },
  "conditions": {
    "clientAppTypes": [
      "all"
    ]
  },
  "grant": {
    "operator": "OR",
    "builtInControls": [
      "mfa"
    ]
  }
